{
    "name": "PWA 画像エディタ",
    "short_name": "画像エディタ",
    "description": "トリミング、マスキング、WebP変換が可能な高機能画像編集PWA",
    "start_url": "./",
    "display": "standalone",
    "background_color": "#f8fafc",
    "theme_color": "#4285F4",
    "icons": [
        {
            "src": "icon.svg",
            "sizes": "512x512",
            "type": "image/svg+xml",
            "purpose": "any maskable"
        }
    ],
    "share_target": {
        "action": "./",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                {
                    "name": "image",
                    "accept": ["image/*"]
                }
            ]
        }
    }
}